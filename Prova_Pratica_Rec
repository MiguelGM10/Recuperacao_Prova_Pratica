select
    c.endereco_wallet,
    c.rede_blockchain,
    c.saldo_usd,
    i.nome,
    i.cpf
from carteiras c
inner join investidores i on c.investidor_id = i.id
where c.status in ('Ativa', 'Em Analise');

select
    co.nome_exchange,
    coalesce(SUM(t.valor_pago), 0) as total_movimentado
from corretoras co
left join criptomoedas cr on co.id = cr.corretora_id
left join transacoes_cripto t on cr.id = t.criptomoeda_id
group by co.nome_exchange
order by total_movimentado DESC;

select
    c.endereco_wallet,
    cr.nome_moeda,
    t.quantidade,
    t.valor_pago,
    t.data_transacao
from transacoes_cripto t
inner join carteiras c on t.carteira_id = c.id
inner join criptomoedas cr on t.criptomoeda_id = cr.id
where t.valor_pago > 500
order by t.valor_pago DESC;

create or replace view vw_painel_carteiras AS
select
    c.endereco_wallet,
    c.rede_blockchain,
    c.status,
    c.saldo_usd,
    i.nome AS nome_investidor,
    i.cpf
from carteiras c
inner join investidores i on c.investidor_id = i.id;

create or replace view vw_investimento_total_carteiras AS
select
    c.id AS id_carteira,
    c.endereco_wallet,
    c.saldo_usd,
    COUNT(t.id) AS quantidade_transacoes,
    COALESCE(SUM(t.valor_pago), 0) AS custo_total_compras
from carteiras c
left join transacoes_cripto t on c.id = t.carteira_id
group by c.id, c.endereco_wallet, c.saldo_usd;



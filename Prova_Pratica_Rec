create table investidores (
    id serial primary key,
    nome varchar(100) NOT NULL,
    cpf varchar(11) UNIQUE NOT NULL,
    nivel_experiencia INT DEFAULT 0 CHECK (nivel_experiencia >= 0)
);

create table carteiras (
    id serial primary key,
    investidor_id INT REFERENCES investidores(id),
    endereco_wallet VARCHAR(100) UNIQUE NOT NULL,
    rede_blockchain VARCHAR(50) NOT NULL,
    saldo_usd DECIMAL(12,2) CHECK (saldo_usd > 0) NOT NULL,
    status VARCHAR(20) DEFAULT 'Ativa' CHECK (status IN ('Ativa', 'Em Analise', 'Bloqueada', 'Pausada'))
);

create table corretoras (
    id serial primary key,
    nome_exchange VARCHAR(100) NOT NULL,
    cnpj VARCHAR(14) UNIQUE NOT NULL,
    email_suporte VARCHAR(100) UNIQUE NOT NULL
);

create table criptomoedas (
    id serial primary key,
    corretora_id INT REFERENCES corretoras(id),
    nome_moeda VARCHAR(100) NOT NULL,
    preco_unitario_usd DECIMAL(12,2) CHECK (preco_unitario_usd > 0) NOT NULL,
    categoria VARCHAR(20) DEFAULT 'Layer1' CHECK (categoria IN ('Layer1', 'DeFi', 'Memecoin', 'Stablecoin'))
);

create table transacoes_cripto (
    id serial primary key,
    carteira_id INT REFERENCES carteiras(id),
    criptomoeda_id INT REFERENCES criptomoedas(id),
    quantidade DECIMAL(12,6) CHECK (quantidade > 0) NOT NULL,
    valor_pago DECIMAL(12,2) CHECK (valor_pago > 0) NOT NULL,
    data_transacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL
);

